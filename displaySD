-- patch select program change functions -----------------------------------------------------------------------------------------------------------
function selectIt(valueObject, value)
  if value==0 then return end
  local message = valueObject:getMessage ()
  local parameterNumber = message:getParameterNumber ()
  local messageValue = message:getValue ()
  local bankLSB = parameterMap.get (deviceId, PT_VIRTUAL, parameterNumber-messageValue -1)
  local progNum = parameterMap.get (deviceId, PT_VIRTUAL, parameterNumber-messageValue ) + messageValue - 2
  if progNum == 128 then progNum= 0 end
  if progNum == -1   then progNum=127  end
  parameterMap.set (deviceId, PT_VIRTUAL, parameterNumber-messageValue,progNum)
  print (string.format("selecting patch: Bank = %d, Prog = %d", bankLSB, progNum))
  print("on MIDI channel: "..currentChannel)
  midi.sendControlChange(currentPort , currentChannel , 32, bankLSB)
  midi.sendProgramChange(currentPort , currentChannel , progNum)
  local mode = parameterMap.get(deviceId, PT_VIRTUAL, 10028)
  local part = parameterMap.get(deviceId, PT_VIRTUAL, 10029)
  if mode > 0 and part == 0 then
    sdMatrix[1][1] = progNum
    sdMatrix[1][2] = bankLSB
    sdMatrix[37][1] = progNum
    sdMatrix[37][2] = bankLSB
  elseif mode > 0 and part == 1 then
    sdMatrix[1][3] = progNum
    sdMatrix[1][4] = bankLSB
    sdMatrix[37][3] = progNum
    sdMatrix[37][4] = bankLSB
  end
  -- Force a UI refresh for the updated slots:
  displaySD(nil, 0)   -- redraw slot 1 (sdMatrix[1])
  displaySD(nil, 36)  -- redraw slot 37 (sdMatrix[37])
end

function displaySD (valueObject, value)
  local mode = parameterMap.get(deviceId, PT_VIRTUAL, 10028)
  local v = 0
  if mode == 0 then return end -- single
  if mode == 2 then  -- split
    v = value + 1
  elseif mode == 1 then -- double
    v = value + 37
  end
  local UP = math.floor(sdMatrix[v][1] + 1)
  local UB = math.floor(sdMatrix[v][2] + 1)
  local LP = math.floor(sdMatrix[v][3] + 1)
  local LB = math.floor(sdMatrix[v][4] + 1)
  local bank = {"A","B","C","D"} -- abbreviations of the bank names

  if nameBank and nameBank[UB] and nameBank[UB][UP] then
    local displayName = bank[UB] .. tostring(UP) .. " " .. (nameBank[UB][UP] or "")
    if v >= 1 and v < 37 then
      controls.get(166):setName(displayName)
    elseif v >= 37 then
      controls.get(216):setName(displayName)
    end
  end
  if nameBank and nameBank[LB] and nameBank[LB][LP] then
    if v >= 1 and v < 37  then 
      controls.get(174):setName(bank[LB]..""..LP.." "..nameBank[LB][LP])
    elseif v >= 37  then
      controls.get(226):setName(bank[LB]..""..LP.." "..nameBank[LB][LP])
    end
  end
  -- set the stored split/double performance parameters
  local nrpn_mult_mappings = {
    {130, sdMatrix[v][8]}, -- Performance pitch bend range (/64)
    {131, sdMatrix[v][9]}, -- Performance octave pitch transpose (/64)
    {134, sdMatrix[v][10]}, -- Performance LFO depth (/64)
    {132, sdMatrix[v][11]}, -- Performance LFO rate (/64)
  }
  for _, m in ipairs(nrpn_mult_mappings) do
    parameterMap.set(deviceId, PT_NRPN, m[1], (m[2] or 0) * 64)
  end
  local nrpn_mappings = {
    {1280, sdMatrix[v][6]}, -- Performance keyboard split point
    {133, sdMatrix[v][12]}, -- Performance LFO shape
  }
  for _, m in ipairs(nrpn_mappings) do
    parameterMap.set(deviceId, PT_NRPN, m[1], m[2])
  end
  local pset_mappings = {
    {{115,117,118,119}, sdMatrix[v][5]},           -- Performance LFO mods
    {{8,10,19,97,103,109}, sdMatrix[v][7]},        -- Performance panel settings
  }
  for _, m in ipairs(pset_mappings) do
    pset(m[1], m[2])
  end
end

