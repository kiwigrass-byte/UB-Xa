 function parameterMap.onChange(valueObjects, origin, midiValue)
  if origin ~= INTERNAL then return end
  local msg = valueObjects[1]:getMessage()
  local parameterNumber = msg:getParameterNumber()
  -- get patch data when a patch selection has been made and after a program change executed 
  if (parameterNumber == 6035 or parameterNumber == 6034 or parameterNumber == 6036 ) and midiValue > 0 then
    local part = parameterMap.get(deviceId, PT_VIRTUAL, 10029)
    if part == 0 then -- upper patch
      getUpperPatch()
    print("upper patch requested")
    elseif part == 1 then -- lower patch
      getLowerPatch()
    print("lower patch requested")
    end
  end
  -- get atrophy data when a profile number has been selected  
  if (parameterNumber == 909 ) and midiValue == 8 then  -- profile saved in patch
    local message = {0x00, 0x20, 0x32, 0x00, 0x01, MODEL_BYTE, 0x7F, 0x74, 0x07, 
    0x03, 0x00, 0x42, 0x49, 0x4E, 0x20, 0x41, 0x74, 0x72, 0x6F, 0x70, 
    0x68, 0x79, 0x20, 0x53, 0x65, 0x74, 0x74, 0x69, 0x6E, 0x67, 0x73}
    midi.sendSysex (currentPort, message)
  elseif (parameterNumber == 909 ) and midiValue < 8 then -- a stored profile
    local aNum = 49+midiValue -- atrophy profile ascii # (-> decimal)
    local message = {0x00, 0x20, 0x32, 0x00, 0x01, MODEL_BYTE, 0x7F, 0x74, 0x07, 
    0x03, 0x00, 0x42, 0x49, 0x4E, 0x20, 0x41, 0x74, 0x72, 0x6F, 0x70, 
    0x68, 0x79, 0x58, 0x20, aNum, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20}
    midi.sendSysex (currentPort, message)
  end
  -- 36 sets of 12 split data parameters
  if parameterNumber == 10023 then
    if midiValue == nil then return end
    local v = midiValue + 1 -- midiValue goes from 0..35
    local idx = {1,2,3,4,5,6,7,10,12,13,14,15} -- split/double parameters are in these columns of sdMatrix
    local p = {}
    for i = 1,#idx do
      p[i] = sdMatrix[v][idx[i]] -- sdMatrix is a global, created when a split-double sysex dump is processed
--      print(p[i])
    end
    -- global upper and lower patch and bank locations
    UP = (p[1] or 0) + 1
    UB = (p[2] or 0) + 1
    LP = (p[3] or 0) + 1
    LB = (p[4] or 0) + 1
  print(UP .. " " .. UB .. " " ..LP.." " ..LB)
   -- display loaded upper and lower split patch names
    if nameBank and nameBank[UB] and nameBank[UB][UP] then
      controls.get(166):setName(nameBank[UB][UP])
    end
    if nameBank and nameBank[LB] and nameBank[LB][LP] then
      controls.get(174):setName(nameBank[LB][LP])
    end 
    -- set the associated performance parameters 
    local mappings = {
    {130, p[8]},  -- Performance pitch bend range (/64)
    {131, p[9]},  -- Performance octave pitch transpose (/64)
    {134, p[10]},  -- Performance LFO depth (/64) ??
    {132, p[11]},  -- Performance LFO rate (/64)
    }
    for _, m in ipairs(mappings) do
      parameterMap.set(deviceId, PT_NRPN, m[1], m[2]*64)
    end
    local mappings = {
    {1280, p[6]},  -- Performance keyboard split point
    {133, p[12]},  -- Performance LFO shape
    }
    for _, m in ipairs(mappings) do
      parameterMap.set(deviceId, PT_NRPN, m[1], m[2])
    end
    local mappings = {
    {{115,117,118,119},p[5]},            -- 135 Performance LFO mods
    {{8,10,19,97,103,109},p[7]},         -- 129 Performance panel settings
    }
    for _, m in ipairs(mappings) do
      pset(m[1], m[2])
    end
  end 
  -- 36 sets of 12 double data parameters
  if parameterNumber == 10030 then
    if midiValue == nil then return end
    local v = midiValue + 1 -- midiValue goes from 0..35
    local idx = {1,2,3,4,5,6,7,10,12,13,14,15} -- split/double parameters are in these columns of sdMatrix
    local p = {}
    for i = 1,#idx do
      p[i] = sdMatrix[v][idx[i]] -- sdMatrix is a global, created when a split-double sysex dump is processed
--      print(p[i])
    end
    -- global upper and lower patch and bank locations
    UP = (p[1] or 0) + 1
    UB = (p[2] or 0) + 1
    LP = (p[3] or 0) + 1
    LB = (p[4] or 0) + 1
   -- display loaded upper and lower split patch names
    if nameBank and nameBank[UB] and nameBank[UB][UP] then
      controls.get(216):setName(nameBank[UB][UP])
    end
    if nameBank and nameBank[LB] and nameBank[LB][LP] then
      controls.get(317):setName(nameBank[LB][LP])
    end 
    -- set the associated performance parameters 
    local mappings = {
    {130, p[8]},  -- Performance pitch bend range (/64)
    {131, p[9]},  -- Performance octave pitch transpose (/64)
    {134, p[10]},  -- Performance LFO depth (/64) ??
    {132, p[11]},  -- Performance LFO rate (/64)
    }
    for _, m in ipairs(mappings) do
      parameterMap.set(deviceId, PT_NRPN, m[1], m[2]*64)
    end
    local mappings = {
    {1280, p[6]},  -- Performance keyboard split point
    {133, p[12]},  -- Performance LFO shape
    }
    for _, m in ipairs(mappings) do
      parameterMap.set(deviceId, PT_NRPN, m[1], m[2])
    end
    local mappings = {
    {{115,117,118,119},p[5]},            -- 135 Performance LFO mods
    {{8,10,19,97,103,109},p[7]},         -- 129 Performance panel settings
    }
    for _, m in ipairs(mappings) do
      pset(m[1], m[2])
    end
  end 
  -- Split Double mode
  if (parameterNumber == 10028 ) then
    if midiValue == 0 then SD_FLAG = 0
    elseif midiValue == 1 then -- get stored split-double data
      SD_FLAG = 1 
      local message = {0x00, 0x20, 0x32, 0x00, 0x01, MODEL_BYTE, 0x7F, 0x74, 0x07, 
        0x03, 0x00, 0x42, 0x49, 0x4E, 0x20, 0x53, 0x70, 0x6C, 0x69, 0x74, 
        0x20, 0x44, 0x6F, 0x75, 0x62, 0x6C, 0x65, 0x20, 0x20, 0x20, 0x20}
      midi.sendSysex (currentPort, message)
    end
  end
end

function upperSD(valueObject,value)
  if value == 0 then return end  
  parameterMap.set(deviceId, PT_VIRTUAL, 10029, 0)
  local bankLSB = UB - 1
  local bank = bankLSB + 65 -- ascii
  local progNum = UP - 1
  midi.sendControlChange(currentPort , currentChannel , 32, bankLSB)
  midi.sendProgramChange(currentPort , currentChannel , progNum)
  SD_FLAG = 1 -- turn on flag that split-double perfomance settings will overide patch settings
  print (string.format("selecting upper patch: Bank = %d, Prog = %d", bankLSB, progNum))
  getUpperPatch()
end

function lowerSD(valueObject,value)
  if value == 0 then return end  
  parameterMap.set(deviceId, PT_VIRTUAL, 10029, 1)
  local bankLSB = LB - 1
  local bank = bankLSB + 65 -- ascii
  local progNum = LP - 1
  print(lowerChannel)
  midi.sendControlChange(currentPort , currentChannel , 32, bankLSB)
  midi.sendProgramChange(currentPort , currentChannel , progNum)
  SD_FLAG = 1 -- turn on flag that split-double perfomance settings will overide patch settings
  print (string.format("selecting lower patch: Bank = %d, Prog = %d", bankLSB, progNum))
  getLowerPatch()
end
