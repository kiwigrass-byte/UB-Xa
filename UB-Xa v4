local function resetVirtualAndControl(paramId, ctrlId)
  parameterMap.set(deviceId, PT_VIRTUAL, paramId, 0)
  local c = safeGet(ctrlId)
  if c and type(c.setValue) == "function" then
    pcall(function() c:setValue(0) end)
  end
end

-- display function for patch mode setting values
function patchMode(valueObject, value)
  -- track previous mode and reset sticky params on transition
  local prevMode = parameterMap.get(deviceId, PT_VIRTUAL, VP.MODE)
  -- write the new mode first so downstream reads see current state
  parameterMap.set(deviceId, PT_VIRTUAL, VP.MODE, value)
  -- clear sticky params on BOTH directions
  if prevMode ~= nil and prevMode ~= value then
    -- transitions between 0 and 1 => reset 10030 + its control
    if (prevMode == 0 and value == 1) or (prevMode == 1 and value == 0) then
      resetVirtualAndControl(VP.DOUBLE_SLOT, CID.DOUBLE_UPPER)
      resetVirtualAndControl(VP.STICKY_PARAM, CID.DOUBLE_LOWER)
    end
    -- transitions between 1 and 2 => reset 10023 + its control
    if (prevMode == 1 and value == 2) or (prevMode == 2 and value == 1) then
      resetVirtualAndControl(VP.SPLIT_SLOT, CID.SPLIT_STICKY)
      resetVirtualAndControl(VP.STICKY_PARAM, CID.SPLIT_LOWER)
    end
  end
  local visibilityMap = {
    [0] = { show = {}, hide = {CID.DOUBLE_UPPER, CID.DOUBLE_LOWER, CID.SPLIT_UPPER, CID.SPLIT_LOWER,
                               CID.SD_INDICATOR, CID.SPLIT_CTRL, CID.SD_INDICATOR2, CID.SD_INDICATOR3} },
    [1] = { show = {CID.DOUBLE_UPPER, CID.DOUBLE_LOWER, CID.SD_INDICATOR, CID.SD_INDICATOR2, CID.SD_INDICATOR3},
            hide = {CID.SPLIT_CTRL, CID.SPLIT_UPPER, CID.SPLIT_LOWER} },
    [2] = { show = {CID.SPLIT_UPPER, CID.SPLIT_LOWER, CID.SPLIT_CTRL, CID.SD_INDICATOR, CID.SD_INDICATOR2, CID.SD_INDICATOR3},
            hide = {CID.DOUBLE_UPPER, CID.DOUBLE_LOWER} },
  }
  if visibilityMap[value] then
    if value == 0 then
      parameterMap.set(deviceId, PT_VIRTUAL, VP.PART_SEL, 0)
      SD_FLAG = 0 -- split/double flag off
    end
    local config = visibilityMap[value]
    for _,id in ipairs(config.hide) do
      local c = safeGet(id); if c then c:setVisible(false) end
    end
    for _,id in ipairs(config.show) do
      local c = safeGet(id); if c then c:setVisible(true) end
    end
  end
  local TARGET_SLOT1 = 26
  local TARGET_SLOT2 = 27
  local TARGET_PAGE = 1
  local c216  = controls.get(CID.DOUBLE_UPPER)
  local c226 = controls.get(CID.DOUBLE_LOWER)
  local c166  = controls.get(CID.SPLIT_UPPER)
  local c174 = controls.get(CID.SPLIT_LOWER)
  if value == 1 then
    c216:setSlot(TARGET_SLOT1, TARGET_PAGE)
    c226:setSlot(TARGET_SLOT2, TARGET_PAGE)
  elseif value == 2 then
    c166:setSlot(TARGET_SLOT1, TARGET_PAGE)
    c174:setSlot(TARGET_SLOT2, TARGET_PAGE)
  end
  -- force redraw after resets + visibility changes
  displaySD(nil, 0)
  displaySD(nil, 36)
end

