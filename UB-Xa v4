-- parameterMap.onChange() seems to be delayed slightly relative to a UI parameter callback function, making successful parsing of sysEx dumps more likely 
function parameterMap.onChange(valueObjects, origin, midiValue)
  if origin ~= INTERNAL then return end
  local msg = valueObjects[1]:getMessage()
  local parameterNumber = msg:getParameterNumber()
  -- patch data when a patch selection has been made and after a program change executed
  if parameterNumber == SELECT_MINUS or parameterNumber == SELECT_IT or parameterNumber == SELECT_PLUS then
    if midiValue > 0 then
      local part = parameterMap.get(deviceId, PT_VIRTUAL, PART_NUMBER)
      if part == 0 then
        getUpperPatch()
        print("upper patch requested")
      elseif part == 1 then
        getLowerPatch()
        print("lower patch requested")
      end
    end
  end
  if parameterNumber == SELECT_SD then
    if midiValue > 0 then
      local part = parameterMap.get(deviceId, PT_VIRTUAL, PART_NUMBER)
      if part == 0 then
        getUpperPatch()
        print("upper patch requested")
      elseif part == 1 then
        getLowerPatch()
        print("lower patch requested")
      end
    end
  end
  -- atrophy data when a profile number has been selected
  if parameterNumber == ATROPHY_NUMBER then
    if midiValue == 8 then -- profile saved in patch
      local message = {0x00,0x20,0x32,0x00,0x01,MODEL_BYTE,0x7F,0x74,0x07,
                       0x03,0x00,0x42,0x49,0x4E,0x20,0x41,0x74,0x72,0x6F,0x70,
                       0x68,0x79,0x20,0x53,0x65,0x74,0x74,0x69,0x6E,0x67,0x73}
      midi.sendSysex(currentPort, message)
    elseif midiValue < 8 then -- a stored profile
      local aNum = 49 + midiValue
      local message = {0x00,0x20,0x32,0x00,0x01,MODEL_BYTE,0x7F,0x74,0x07,
                       0x03,0x00,0x42,0x49,0x4E,0x20,0x41,0x74,0x72,0x6F,0x70,
                       0x68,0x79,0x58,0x20,aNum,0x20,0x20,0x20,0x20,0x20,0x20}
      midi.sendSysex(currentPort, message)
    end
  end
  -- Split Double mode toggle / request stored split-double data
  if parameterNumber == PATCH_MODE then
    if midiValue == 1 then  -- multi 
      SD_FLAG = 1  -- set split/double flag on and request stored split/double data
      local message = {0x00,0x20,0x32,0x00,0x01,MODEL_BYTE,0x7F,0x74,0x07,
                       0x03,0x00,0x42,0x49,0x4E,0x20,0x53,0x70,0x6C,0x69,0x74,
                       0x20,0x44,0x6F,0x75,0x62,0x6C,0x65,0x20,0x20,0x20,0x20}
      midi.sendSysex(currentPort, message)
    end
  end
end

