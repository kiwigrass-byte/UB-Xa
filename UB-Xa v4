local function resetVirtualAndControl(paramId, ctrlId)
  parameterMap.set(deviceId, PT_VIRTUAL, paramId, 0)
  local c = safeGet(ctrlId)
  if c and type(c.setValue) == "function" then
    pcall(function() c:setValue(0) end)
