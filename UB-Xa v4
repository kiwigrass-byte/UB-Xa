-- ============================================================
-- NRPN / CC PROCESSING
-- ============================================================

-- Construct a midi.onNrpn(callback) by listening to midi.onControlChange
-- callback(channel, nrpnParam, value, info)
-- nrpnParam = 0..16383 (msb*128 + lsb)
-- value = combined 14-bit value if LSB available, otherwise 7-bit MSB value (or amount for inc/dec)
-- info.type = "data_entry_msb" | "data_entry_lsb" | "inc" | "dec"
-- info.msb / info.lsb included when applicable
-- core processor expects (channel, controller, value)
function process_cc(channel, controller, value)
  if not channel then return end
  local s = nrpn_state[channel] or { nrpn_msb = nil, nrpn_lsb = nil, data_msb = nil, data_lsb = nil }
  -- NRPN parameter select
  if controller == 99 then -- NRPN MSB
    if value == 127 then
      -- deselect NRPN
      s.nrpn_msb = nil; s.nrpn_lsb = nil; s.data_msb = nil; s.data_lsb = nil
    else
      s.nrpn_msb = value
      s.data_msb = nil; s.data_lsb = nil
    end
  elseif controller == 98 then -- NRPN LSB
    if value == 127 then
      s.nrpn_msb = nil; s.nrpn_lsb = nil; s.data_msb = nil; s.data_lsb = nil
    else
      s.nrpn_lsb = value
      s.data_msb = nil; s.data_lsb = nil
    end
  -- Data Entry MSB (CC 6)
  elseif controller == 6 then
    if s.nrpn_msb and s.nrpn_lsb then
      s.data_msb = value
      local param = s.nrpn_msb * 128 + s.nrpn_lsb
      local combined = value
      if s.data_lsb then
        combined = (s.data_msb * 128) + s.data_lsb
      end
      if nrpn_callback then
        nrpn_callback(channel, param, combined, { type = "data_entry_msb", msb = value, lsb = s.data_lsb })
      end
    end
  -- Data Entry LSB (CC 38)
  elseif controller == 38 then
    if s.nrpn_msb and s.nrpn_lsb then
      s.data_lsb = value
      local param = s.nrpn_msb * 128 + s.nrpn_lsb
      local combined = ((s.data_msb or 0) * 128) + s.data_lsb
      if nrpn_callback then
        nrpn_callback(channel, param, combined, { type = "data_entry_lsb", msb = s.data_msb, lsb = value })
      end
    end
  -- Data Increment (96) / Decrement (97)
  elseif controller == 96 or controller == 97 then
    if s.nrpn_msb and s.nrpn_lsb then
      local param = s.nrpn_msb * 128 + s.nrpn_lsb
      local kind = controller == 96 and "inc" or "dec"
      if nrpn_callback then
        nrpn_callback(channel, param, value, { type = kind, amount = value })
      end
    end
  end
  nrpn_state[channel] = s
end

-- wrapper that normalizes incoming args:
-- supports (channel, controller, value) and (port, channel, controller, value)
local function cc_wrapper(...)
  local n = select("#", ...)
  if n == 4 then
    -- (port, channel, controller, value)
    local _, channel, controller, value = ...
    process_cc(channel, controller, value)
  else
    -- assume (channel, controller, value)
    local channel, controller, value = ...
    process_cc(channel, controller, value)
  end
end

-- Utility: try to call a possible registrar safely
local function try_call_registrar(registrar, handler)
  local ok, err = pcall(function() registrar(handler) end)
  return ok, err
end

-- Register a single NRPN callback. Calling multiple times replaces the previous callback.
function midi.onNrpn(callback)
  nrpn_callback = callback
  if not registered then
    -- If midi.onControlChange is a function, it might be either:
    -- 1) a registrar function that accepts a handler, or
    -- 2) an existing handler (callable) that should be wrapped/kept.
    local m = midi.onControlChange
    if type(m) == "function" then
      -- First attempt: try calling it as a registrar: midi.onControlChange(handler)
      local ok = try_call_registrar(m, cc_wrapper)
      if ok then
        -- registration succeeded (API is registrar-style)
        registered = true
        return
      else
        -- calling it failed -> treat it as an existing handler: wrap it
        local existing = m
        midi.onControlChange = function(...)
          -- preserve existing behavior
          pcall(existing, ...)
          -- then run our wrapper
          cc_wrapper(...)
        end
        registered = true
        return
      end
    else
      -- Not a function (nil or not present) -> assign directly
      midi.onControlChange = cc_wrapper
      registered = true
      return
    end
  end
end

