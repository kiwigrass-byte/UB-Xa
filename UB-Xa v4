-- display function for patch mode setting values
function patchMode(valueObject, value)
  -- track previous mode and reset sticky params on transition
  local prevMode = parameterMap.get(deviceId, PT_VIRTUAL, PATCH_MODE)
  -- write the new mode first so downstream reads see current state
  parameterMap.set(deviceId, PT_VIRTUAL, PATCH_MODE, value)
  -- clear sticky params on BOTH directions
  if prevMode ~= nil and prevMode ~= value then
    -- transitions between 0 and 1 => reset DOUBLE_NUMBER + its control
    if (prevMode == 0 and value == 1) or (prevMode == 1 and value == 0) then
      resetVirtualAndControl(DOUBLE_NUMBER, 216)
      resetVirtualAndControl(DUMMY_NUMBER, 226)
    end
    -- transitions between 1 and 2 => reset SPLIT_NUMBER + its control
    if (prevMode == 1 and value == 2) or (prevMode == 2 and value == 1) then
      resetVirtualAndControl(SPLIT_NUMBER, 116)
      resetVirtualAndControl(DUMMY_NUMBER, 174)
    end
  end
  local visibilityMap = {
    [0] = { show = {}, hide = {216,226,166,174,321,58,231,329} },
    [1] = { show = {216,226,321,231,329}, hide = {58,166,174} },
    [2] = { show = {166,174,58,321,231,329}, hide = {216,226} },
  }
  if visibilityMap[value] then
    if value == 0 then -- single mode
      parameterMap.set(deviceId, PT_VIRTUAL, PART_NUMBER, 0)
      SD_FLAG = 0 -- split/double flag off
    end
    local config = visibilityMap[value]
    for _,id in ipairs(config.hide) do
      local c = safeGet(id); if c then c:setVisible(false) end
    end
    for _,id in ipairs(config.show) do
      local c = safeGet(id); if c then c:setVisible(true) end
    end
  end
  if value == 1 then
    controls.get(CTRL_UPPER_DOUBLE):setSlot(TARGET_SD_SLOT1, TARGET_SD_PAGE)
    controls.get(CTRL_LOWER_DOUBLE):setSlot(TARGET_SD_SLOT2, TARGET_SD_PAGE)
  elseif value == 2 then
    controls.get(CTRL_UPPER_SPLIT):setSlot(TARGET_SD_SLOT1, TARGET_SD_PAGE)
    controls.get(CTRL_LOWER_SPLIT):setSlot(TARGET_SD_SLOT2, TARGET_SD_PAGE)
  end
  -- force redraw after resets + visibility changes
  displaySD(nil, 0)
  displaySD(nil, 36)
end

