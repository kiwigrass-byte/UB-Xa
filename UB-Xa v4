-- process a split double dump
function splitDouble(dump)
  -- parse of the incoming dump
  local result = parse_sysex(dump)
  if not result or type(result.data) ~= "table" then
    print("Could not read data")
    return
  end
  local data = result.data
  for i = 1308, 1305, -1 do
    table.remove(data, i)   -- ignore the last 4 bytes that are EOF data.
  end
  for i = 8, 1, -1 do
    table.remove(data, i)  -- ignore the first 8 bytes that are TOF data.
  end
--  for i = 1,#data do 
  for i = 1,#data do 
--    print("split double: byte values: ".. i .. ": " .. data[i])
  end
  local rows, cols = 72, 18
  local idx = {1,2,3,4,5,6,7,10,12,13,14,15} -- 12 columns to extract
  sdMatrix = {}
  for r = 1, rows do
    sdMatrix[r] = {}
    local base = (r - 1) * cols
    for i = 1, #idx do
      sdMatrix[r][i] = data[base + idx[i]]
    end
  end
--[[
  -- for debugging
  for i = 1, 72 do
    local row_str = ""
    for j = 1, 12 do
        -- Format each number with 2 decimal places and a width of 6 spaces
        row_str = row_str .. string.format("%4.0f ", sdMatrix[i][j])
    end
    print(row_str)
  end
]]
  print("split double settings parsed. Number of bytes: ".. #data)
end

-- for patch name dump
function patchNames(dump)
-- parse of the incoming dump. This takes a few seconds becaus ethere are 8192 bytes
  local result = parse_sysex(dump)
  if not result or type(result.data) ~= "table" then
    print("Could not read data")
    return
  end
  local data = result.data
  -- Treat the flat array as 4 banks of 128 each and map them so pNames[bank][patch] = flat[(bank-1)*128 + patch]
  -- This produces 4 rows (banks) with 128 columns (patches) in each row.
  for bank = 1,4 do
    nameBank[bank] = {}
    for patch = 1,128 do
      local flatIndex = (bank - 1) * 128 + patch         -- 1..512
      local byteOffset = (flatIndex - 1) * 16 + 1        -- original stepping by 16 bytes
      nameBank[bank][patch] = get_patch_name(data, byteOffset)
    end
  end
  --for bank = 1,#nameBank do
  --  print("bank "..bank.." : "..table.concat(nameBank[bank], " | "))
  --end
  print("patch names parsed. Number of bytes: ".. #data)
end

