-- helper function to extract ascii bytes from a number
local function asciiBytesFromNumber(n, width)
  local s = string.format("%0"..tostring(width).."d", n)
  local bytes = {}
  for i=1,#s do bytes[#bytes+1] = string.byte(s,i) end
  return bytes
end

-- patch select program change functions -----------------------------------------------------------------------------------------------------------
function selectIt(valueObject, value)
  if value==0 then return end
  local message = valueObject:getMessage ()
  local parameterNumber = message:getParameterNumber ()
  local messageValue = message:getValue ()
  local bankLSB = parameterMap.get (deviceId, PT_VIRTUAL, parameterNumber-messageValue -1)
  local progNum = parameterMap.get (deviceId, PT_VIRTUAL, parameterNumber-messageValue ) + messageValue - 2
  if progNum == 128 then progNum= 0 end
  if progNum == -1   then progNum=127  end
  parameterMap.set (deviceId, PT_VIRTUAL, parameterNumber-messageValue,progNum)
  print (string.format("selecting patch: Bank = %d, Prog = %d, Channel = %d", bankLSB, progNum, currentChannel))
  midi.sendControlChange(currentPort , currentChannel , 32, bankLSB)
  midi.sendProgramChange(currentPort , currentChannel , progNum)
  local mode = parameterMap.get(deviceId, PT_VIRTUAL, VP.MODE)
  local part = parameterMap.get(deviceId, PT_VIRTUAL, VP.PART_SEL)
  if mode > 0 and part == 0 then
    sdMatrix[1][1] = progNum
    sdMatrix[1][2] = bankLSB
    sdMatrix[37][1] = progNum
    sdMatrix[37][2] = bankLSB
  elseif mode > 0 and part == 1 then
    sdMatrix[1][3] = progNum
    sdMatrix[1][4] = bankLSB
    sdMatrix[37][3] = progNum
    sdMatrix[37][4] = bankLSB
  end
  -- Force a UI refresh for the updated slots:
  displaySD(nil, 0)   -- redraw slot 1 (sdMatrix[1])
  displaySD(nil, 36)  -- redraw slot 37 (sdMatrix[37])
end

function selectSD(valueObject, value)
  if value==0 then return end
  local message = valueObject:getMessage ()
  local parameterNumber = message:getParameterNumber ()
  local messageValue = message:getValue ()
  local mode = parameterMap.get (deviceId, PT_VIRTUAL, VP.MODE)
  local v = 0
  if mode == 0 then return
  elseif mode == 1 then  
    v = parameterMap.get (deviceId, PT_VIRTUAL, VP.DOUBLE_SLOT) + 1 -- only can load 35 stored doubles
  elseif mode == 2 then  
    v = parameterMap.get (deviceId, PT_VIRTUAL, VP.SPLIT_SLOT) + 1 -- only can load 35 stored splits
  end
  local bankLSB = {sdMatrix[v][2],sdMatrix[v][4]}
  local progNum = {sdMatrix[v][1],sdMatrix[v][3]}
  print (string.format("selecting upper patch: Bank = %d, Prog = %d, Channel = %d", bankLSB[1], progNum[1], ubxaUpperCh))
  midi.sendControlChange(currentPort , ubxaUpperCh , 32, bankLSB[1])
  midi.sendProgramChange(currentPort , ubxaUpperCh , progNum[1])
  print (string.format("selecting lower patch: Bank = %d, Prog = %d, Channel = %d", bankLSB[2], progNum[2], ubxaLowerCh))
  midi.sendControlChange(currentPort , ubxaLowerCh , 32, bankLSB[2])
  midi.sendProgramChange(currentPort , ubxaLowerCh , progNum[2])
end

function displayPatch (valueObject, value)
  local bankTxt={"A","B","C","D"} -- abbreviations of the bank names
  local bankNum = parameterMap.get (deviceId, PT_VIRTUAL, VP.CURRENT_BANK)+1
  controls.get(CID.PATCH_DISPLAY):setName(nameBank[bankNum][value])  -- display loaded patch names stored in nameBank
  return (string.format(bankTxt[bankNum]).." "..string.format("%03d",value))
end

