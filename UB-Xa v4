-- Formatter factory: returns a function(valueObject, value) that formats value using
-- fmt (format string with one %f/%d/%s slot) and an optional transform function.
-- Usage: myFmt = makeFormatter("%.2f%%", function(v) return 100*v/255 end)
local function makeFormatter(fmt, fn)
  fn = fn or function(v) return v end
  return function(vo, v) return string.format(fmt, fn(v)) end
end

---- value formater functions ----
-- format per voice Pan
function fmtPan(valueObject,value)
  local control = valueObject:getControl():getId()
  local side =" L"
  if (value < 0 ) then 
    controls.get(control):setColor (WHITE)
  elseif (value == 0) then
    side = " Center"
    controls.get(control):setColor (26 *256*256 + 200*256 + 30)
  elseif (value > 0) then
    side = " R"
    controls.get(control):setColor (RED)
  end
  return(string.format ("%.0f%%",100*(math.abs(math.floor(value)))/128) .. side)
end

-- format master output Pan
function fmtMasterPan(valueObject,value)
  local control = valueObject:getControl():getId()
  local side =" L"
  if (value < 0 ) then 
    controls.get(control):setColor (BLUE)
  elseif (value == 0) then
    side = " Center"
    controls.get(control):setColor (WHITE)
  elseif (value > 0) then
    side = " R"
    controls.get(control):setColor (RED)
  end
  return(string.format ("%.0f%%",100*(math.abs(math.floor(value)))/64) .. side)
end

-- format split/double Balance
function fmtBalance(valueObject,value)
  local control = valueObject:getControl():getId()
  local side =" >> LOWER"
  if (value < 0 ) then 
    controls.get(control):setColor (WHITE)
  elseif (value == 0) then
    side = " EQUAL"
    controls.get(control):setColor (GREEN)
  elseif (value > 0) then
    side = " >> UPPER"
    controls.get(control):setColor (RED)
  end
  return(string.format ("%.0f%%",100*(math.abs(value))/128) .. side)
end

