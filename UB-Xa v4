-- This is lua equivalent of the php script by @Electrolove to extract the patch name from a UB-Xa patch sysEx dump
-- Helper: safe getter that treats PHP-style 0-based indices: pass php_index (0-based)
local function get(msg, idx0)
  -- msg is a Lua array indexed from 1..n; PHP index k => Lua index (k+1)
  return msg[idx0 + 1]
end
-- Unpack MIDI 7-bit-packed data.
-- Input: array of bytes indexed 1..n (Lua-style). The PHP code processes groups of 8 bytes:
--   msb byte followed by 7 bytes; bits in msb say whether to set top-bit (0x80) on corresponding byte.
-- Output: array of full bytes (1..m).
function unpack_midi(array)
  local result = {}
  local i = 1
  while i <= #array do
    local msb = array[i] or 0
    for j = 0, 6 do
      local idx = i + j + 1
      local b = array[idx]
      if b ~= nil then
        if (msb & (1 << j)) ~= 0 then
          b = b | 0x80
        end
        result[#result + 1] = b
      end
    end
    i = i + 8
  end
  return result
end
-- Parse a sequence of "messages" (each message is a numeric byte array, 1..n).
-- Mirrors the PHP parse_sysex behavior:
--  - message byte at PHP index 10 indicates type: 1 = header, 2 = data packet
--  - header message: reads type (4 chars), length (4x7bit little-endian), name (16 chars)
--  - data packet: packet_num (msg[11]), packet_len (msg[12]), then payload starting at msg[13]
--  - end condition: PHP msg[3] == 0x7B
-- Returns: header table { name=..., length=..., type=..., data={...} } or nil if not found
function parse_sysex(messages)
  local header = nil
  for _, msg in ipairs(messages) do
    -- header message marker: PHP msg[10] -> Lua get(msg,10)
    if get(msg, 10) == 1 then
      local idx = 12  -- PHP-style index (0-based) used in original code
      -- read 4-character type
      local t = string.char(get(msg, idx) or 0)
      idx = idx + 1
      t = t .. string.char(get(msg, idx) or 0); idx = idx + 1
      t = t .. string.char(get(msg, idx) or 0); idx = idx + 1
      t = t .. string.char(get(msg, idx) or 0); idx = idx + 1
      -- read 4-byte length stored as 4 x 7-bit little-endian pieces (mask with 0x7F)
      local b0 = (get(msg, idx) or 0) & 0x7F; idx = idx + 1
      local b1 = (get(msg, idx) or 0) & 0x7F; idx = idx + 1
      local b2 = (get(msg, idx) or 0) & 0x7F; idx = idx + 1
      local b3 = (get(msg, idx) or 0) & 0x7F; idx = idx + 1
      local length = b0 | (b1 << 7) | (b2 << 14) | (b3 << 21)
      -- read 16-byte name
      local name = ""
      for i = 0, 15 do
        name = name .. string.char(get(msg, idx + i) or 0)
      end
      idx = idx + 16
      -- initialize header and its data buffer (1-based Lua indices)
      header = {
        name = name,
        length = length,
        type = t,
        data = {}
      }
      -- initialize data with zeros (mirrors PHP array_fill(0, $length, 0))
      for i = 1, length do header.data[i] = 0 end
    -- data packet: PHP msg[10] == 2
    elseif get(msg, 10) == 2 and header ~= nil then
      local packet_num = get(msg, 11) or 0
      local packet_len = get(msg, 12) or 0
      -- PHP: $data = array_slice($msg, 13, $packet_len + 1)
      -- packet data are PHP indices 13 .. 13+packet_len (0-based)
      local data = {}
      for k = 0, packet_len do
        data[#data + 1] = get(msg, 13 + k) or 0
      end
      -- PHP array_splice(.., $packet_num * 128, $packet_len + 1, $data)
      -- so destination start is PHP index (packet_num * 128) -> Lua index +1
      local dest_start = packet_num * 128 + 1
      for k = 1, #data do
        header.data[dest_start + k - 1] = data[k]
      end
    -- end marker: PHP msg[3] == 0x7B
    elseif get(msg, 3) == 0x7B and header ~= nil then
      -- unpack the 7bit-packed MIDI data
      header.data = unpack_midi(header.data)
      -- trim to header.length (PHP array_slice(..., 0, $header['length']))
      local trimmed = {}
      for i = 1, math.min(#header.data, header.length) do
        trimmed[i] = header.data[i]
      end
      header.data = trimmed
      return header
    end
  end
  return nil
end

-- helper function for get_patch_name
local function trim(s) return s:match("^%s*(.-)%s*$") end

function get_patch_name(data,startIdx)
  if type(data) ~= "table" then return "" end
  local nameChars = {}
  for i = startIdx, startIdx + 15, 2 do
    local b1 = data[i] or 0
    local b2 = data[i+1] or 0
    local char1 = ((b1 & 0x80) >> 7) + ((b2 & 0xFF) << 1)
    local char2 = b1 & 0x7F
    -- replace non-printable with ' '
    char1 = (char1 >= 32 and char1 <= 126) and char1 or 32
    char2 = (char2 >= 32 and char2 <= 126) and char2 or 32
    nameChars[#nameChars+1] = string.char(char1)
    nameChars[#nameChars+1] = string.char(char2)
  end
  return trim(table.concat(nameChars))
end

function get_atrophy_name(data,startIdx)
  if type(data) ~= "table" then return "" end
  local nameChars = {}
  for i = startIdx, startIdx + 5 do
    local b1 = data[i] or 0
    local char2 = b1 & 0x7F
    -- replace non-printable with ' '
    char2 = (char2 >= 32 and char2 <= 126) and char2 or 32
    nameChars[#nameChars+1] = string.char(char2)
  end
  return trim(table.concat(nameChars))
end

-- process incoming sysEx messages -------------------------------
-- helper functions and globals for midi.onSysex 
local sysex_states = {}
local VENDOR_ID = {0x00, 0x20, 0x32} -- Behringer
local HEADER_MSG_TYPE = 1
local PACKET_MSG_TYPE = 2
local EOF_SYSEX_FOURTH_BYTE = 0x7B -- ACK byte of EOF message

-- Dump type constants
local DUMP_TYPES = {
  UPPER_PATCH = "upperPatch",
  LOWER_PATCH = "lowerPatch",
  PATCH_X = "patchX",
  PATCH_NAMES = "patchNames",
  GLOBAL = "global",
  ATROPHY = "atrophy",
  SPLIT_DOUBLE = "splitDouble",
  CURRENT_PROGRAM = "currentProgram",
}

-- Handler mapping: dumpType -> {endMsgNum, handlerName} -- the names of the processing functions
local HANDLERS = {
  upperPatch = { endMsgNum = 9, handlerName = "patch" },
  lowerPatch = { endMsgNum = 9, handlerName = "patch" },
  patchX = { endMsgNum = 9, handlerName = "patch" },
  patchNames = { endMsgNum = 76, handlerName = "patchNames" },
  global = { endMsgNum = 3, handlerName = "global" },
  atrophy = { endMsgNum = 3, handlerName = "atrophy" },
  splitDouble = { endMsgNum = 14, handlerName = "splitDouble" },
  currentProgram = { endMsgNum = 16, handlerName = "currentProgram" },
}

local function safe_peek(sysexBlock, length, i)
  if type(i) ~= "number" or i < 1 or i > length then return nil end
  return sysexBlock:peek(i)
end

local function peek_string(sysexBlock, length, startIndex, count)
  if startIndex < 1 or count < 1 then return "" end
  local t = {}
  for j = 0, count - 1 do
    local b = safe_peek(sysexBlock, length, startIndex + j)
    if not b then break end
    t[#t+1] = string.char(b)
  end
  return table.concat(t)
end

local function is_vendor_match(sysexBlock, length)
  return safe_peek(sysexBlock, length, 2) == VENDOR_ID[1]
     and safe_peek(sysexBlock, length, 3) == VENDOR_ID[2]
     and safe_peek(sysexBlock, length, 4) == VENDOR_ID[3]
end

local function detect_dump_type(sysexBlock, length)
  local hdrText = peek_string(sysexBlock, length, 21, 16):lower()
  
  if hdrText:find("upper patch", 1, true) then
    return DUMP_TYPES.UPPER_PATCH
  elseif hdrText:find("lower patch", 1, true) then
    return DUMP_TYPES.LOWER_PATCH
  elseif hdrText:find("patchx", 1, true) then
    return DUMP_TYPES.PATCH_X
  elseif hdrText:find("patch names", 1, true) then
    return DUMP_TYPES.PATCH_NAMES
  elseif hdrText:find("global", 1, true) then
    return DUMP_TYPES.GLOBAL
  elseif hdrText:find("atrophy", 1, true) then
    return DUMP_TYPES.ATROPHY
  elseif hdrText:find("split double", 1, true) then
    return DUMP_TYPES.SPLIT_DOUBLE
  elseif hdrText:find("current program", 1, true) then
    return DUMP_TYPES.CURRENT_PROGRAM
  end
  return nil
end

local function reset_state_for_iface(iface)
  sysex_states[iface] = {
    msgNumber = 0,
    section = 0,
    dump = {},
    dumpType = nil,
    last_ts = nil
  }
end

local function call_handler(dumpType, dump)
  local handlerInfo = HANDLERS[dumpType]
  if not handlerInfo then return end
  local fn = _G[handlerInfo.handlerName]
  if type(fn) == "function" then
    pcall(fn, dump)
  else
    print("onSysex: " .. handlerInfo.handlerName .. "() not available")
  end
end

local function log_sysex(msgNumber, iface, length, sysexBlock)
  print(string.format("sysex (msg=%d) message received: interface=%s length=%d",
    msgNumber, iface, length))
  for startIndex = 1, length, 24 do
    local bytes = {}
    local endIndex = math.min(startIndex + 23, length)
    for i = startIndex, endIndex do
      local b = sysexBlock:peek(i) or 0
      bytes[#bytes + 1] = string.format("%02X", b)
    end
    print(string.format("data[%04X]: %s", startIndex - 1, table.concat(bytes, " ")))
  end
end

local function collect_dump(sysexBlock, length)
  local temp = {}
  for i = 1, length do
    local b = sysexBlock:peek(i)
    if not b then break end
    temp[i] = b
  end
  return temp
end

function midi.onSysex(midiInput, sysexBlock)
  local ok, err = pcall(function()
    local length = sysexBlock:getLength()
    local iface = tostring(midiInput.interface or midiInput.name or "unknown")
    local state = sysex_states[iface]
    if not state then
      reset_state_for_iface(iface)
      state = sysex_states[iface]
    end
    -- Reset state if starting a new transfer
    if state.msgNumber == 0 then
      state.dump = {}
      state.section = 0
      state.dumpType = nil
    end
    -- HEADER detection
    if length > 6 and safe_peek(sysexBlock, length, 11) == HEADER_MSG_TYPE then
      local expected_header_msgnum = 1 + (state.section or 0) * 2
      if state.msgNumber ~= 0 and state.msgNumber ~= expected_header_msgnum then
        print("onSysex: unexpected header while msgNumber=" .. tostring(state.msgNumber) .. "; resetting state and starting new transfer")
        reset_state_for_iface(iface)
        state = sysex_states[iface]
      end
      if state.msgNumber == 0 then
        -- Start of first header: validate vendor and model
        state.section = 0
        state.msgNumber = 1
        if not is_vendor_match(sysexBlock, length) then
          print("onSysex: Not Behringer vendor; ignoring message")
          reset_state_for_iface(iface)
          return
        end
        if safe_peek(sysexBlock, length, 7) ~= MODEL_BYTE then
          print("onSysex: Not UB-Xa model; ignoring message")
          reset_state_for_iface(iface)
          return
        end
        -- Detect dump type from header text (only on first header)
        state.dumpType = detect_dump_type(sysexBlock, length)
      else
        -- Additional header: advance section
        state.section = (state.section or 0) + 1
        state.msgNumber = 1 + state.section * 2
        -- dumpType already set by first header, do not reset
      end
    end

    -- PACKET detection: simplified to single peek
    if length > 6 and safe_peek(sysexBlock, length, 11) == PACKET_MSG_TYPE then
      local packetNum = safe_peek(sysexBlock, length, 12)
      if packetNum and packetNum >= 0 and packetNum <= 76 then
        state.msgNumber = packetNum + 2 + (state.section or 0) * 2
      end
    end
    table.insert(state.dump, collect_dump(sysexBlock, length))

    -- Logging (optional)
--    log_sysex(state.msgNumber, iface, length, sysexBlock)
    -- Collect message into dump

    -- Call handler on EOF if applicable
    if state.dumpType then
      local handlerInfo = HANDLERS[state.dumpType]
      if handlerInfo and state.msgNumber == handlerInfo.endMsgNum then
        call_handler(state.dumpType, state.dump)
        reset_state_for_iface(iface)
        return
      end
    end
    -- Advance message number for next call
    state.msgNumber = state.msgNumber + 1
  end)
  if not ok then
    print("onSysex: pcall failed: " .. tostring(err))
  end
end

-- helper function to map an x bit bitmasked byte to a virtual parameter with values 0..2^x-1
function pset(params, value)
  local x = #params
  local v = math.floor(tonumber(value) or 0) & (2^x - 1)
  for i, p in ipairs(params) do
    if p ~= nil then
      local bit = (v >> (i - 1)) & 1
      parameterMap.set(deviceId, PT_VIRTUAL, p, bit) -- sets 1 or 0
    end
  end
end

