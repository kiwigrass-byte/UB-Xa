local function showHelp(helpText)
  info.setText(helpText)
  tickCounter = 0
  timer.enable()
end

function events.onPotTouchChange(potId, controlId, touched)
  if not touched then return end
  local help = HELP_TEXTS[controlId]
  if help then showHelp(help) end
end

local function resetVirtualAndControl(paramId, ctrlId)
  parameterMap.set(deviceId, PT_VIRTUAL, paramId, 0)
  local control = safeGet(ctrlId)
  if control and type(control.setValue) == "function" then
    pcall(function() control:setValue(0) end)
  end
end

-- display function for patch mode setting values
function patchMode(valueObject, value)
  -- track previous mode and reset sticky params on transition
  local prevMode = parameterMap.get(deviceId, PT_VIRTUAL, 10028)
  -- write the new mode first so downstream reads see current state
  parameterMap.set(deviceId, PT_VIRTUAL, 10028, value)
  -- clear sticky params on BOTH directions
  if prevMode ~= nil and prevMode ~= value then
    -- transitions between 0 and 1 => reset 10030 + its control
    if (prevMode == 0 and value == 1) or (prevMode == 1 and value == 0) then
      resetVirtualAndControl(10030, 216)
      resetVirtualAndControl(10024, 226)
    end
    -- transitions between 1 and 2 => reset 10023 + its control
    if (prevMode == 1 and value == 2) or (prevMode == 2 and value == 1) then
      resetVirtualAndControl(10023, 116)
      resetVirtualAndControl(10024, 174)
    end
  end
  local visibilityMap = {
    [0] = { show = {}, hide = {216,226,166,174,321,58,231,329} },
    [1] = { show = {216,226,321,231,329}, hide = {58,166,174} },
    [2] = { show = {166,174,58,321,231,329}, hide = {216,226} },
  }
  if visibilityMap[value] then
    if value == 0 then
      parameterMap.set(deviceId, PT_VIRTUAL, 10029, 0)
      splitDoubleFlag = 0 -- split/double flag off
    end
    local config = visibilityMap[value]
    for _,id in ipairs(config.hide) do
      local control = safeGet(id); if control then control:setVisible(false) end
    end
    for _,id in ipairs(config.show) do
      local control = safeGet(id); if control then control:setVisible(true) end
    end
  end
  local TARGET_SLOT1 = 26
  local TARGET_SLOT2 = 27
  local TARGET_PAGE = 1
  local c216  = controls.get(216)
  local c226 = controls.get(226)
  local c166  = controls.get(166)
  local c174 = controls.get(174)
  if value == 1 then
    c216:setSlot(TARGET_SLOT1, TARGET_PAGE)
    c226:setSlot(TARGET_SLOT2, TARGET_PAGE)
  elseif value == 2 then
    c166:setSlot(TARGET_SLOT1, TARGET_PAGE)
    c174:setSlot(TARGET_SLOT2, TARGET_PAGE)
  end
  -- force redraw after resets + visibility changes
  displaySD(nil, 0)
  displaySD(nil, 36)
end

-- show unison voice or poly voice depending on value of unison toggle
function swapVoiceType(valueObject, value)
  local TARGET_SLOT = 20
  local TARGET_PAGE = 4
