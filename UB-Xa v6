-- Multi-osc quantizer, mode labels and value formatters for UB-Xa preset
-- Supports:
--  - quantizeOscillator1Frequency : oscillator 1 editor Function (NRPN 513, quant param 535, control id 328)
--  - quantizeOscillator2Frequency : oscillator 2 editor Function (NRPN 515, quant param 536, control id 95)
--  - formatOscillator1Frequency / formatOscillator2Frequency as Value formatter functions to show human-friendly text
--
-- Behavior:
--  - Signed display domain: -8192 .. +8191 (but also accepts 0..16383 unsigned and converts)
--  - Semitone interaction for octave modes (fine control), snaps final NRPN to exact octaves
--  - Labels control name to concise mode (e.g. "Transpose +Octaves"), value formatter shows semitones/octaves
--  - Writes exact 14-bit NRPN values to the synth (no approximation)

local STEP_SEMITONE = 64
local STEP_OCTAVE  = 12 * STEP_SEMITONE -- 768
local CENTER_RAW   = 8192
local RAW_MIN, RAW_MAX = 0, 16383
local SIGN_MIN, SIGN_MAX = -8192, 8191

-- tweak sensitivity if needed (<1 = more sensitive, >1 = less)
local SENSITIVITY = 1.0

-- minSemitones / maxSemitones are in semitones
local QUANT_MODES = {
  -- octave modes use semitone stepping for interaction but show octaves
  [0] = { quant = true,  step = STEP_SEMITONE, symmetric = false, octaveDisplay = true,  minSemitones = 0,   maxSemitones = 36 }, -- +Octaves (0..+3 oct)
  [1] = { quant = true,  step = STEP_SEMITONE, symmetric = false, octaveDisplay = false, minSemitones = 0,   maxSemitones = 36 }, -- +Semitones (0..+36 st)
  [2] = { quant = false,                      symmetric = false, octaveDisplay = false, minSemitones = 0,   maxSemitones = 36 }, -- +Free (clamped 0..+36 st)
  [3] = { quant = true,  step = STEP_SEMITONE, symmetric = true,  octaveDisplay = true,  minSemitones = -48, maxSemitones = 36 }, -- +/- Octaves (-4..+3 oct)
  [4] = { quant = true,  step = STEP_SEMITONE, symmetric = true,  octaveDisplay = false, minSemitones = -48, maxSemitones = 36 }, -- +/- Semitones (-48..+36 st)
  [5] = { quant = false,                      symmetric = true,  octaveDisplay = false, minSemitones = -48, maxSemitones = 36 }, -- +/- Free (same clamp range)
}

local function clamp(x, lo, hi) if x < lo then return lo end if x > hi then return hi end return x end

local function roundNearestSteps(signed, step)
  if step == 0 then return 0 end
  local eff = signed / SENSITIVITY
  if eff >= 0 then
    return math.floor((eff + step/2) / step)
  else
    return math.ceil((eff - step/2) / step)
  end
end

-- Read quant mode for a given quantParam (try NRPN then VIRTUAL)
local function readQuantModeFor(quantParam)
  local q = parameterMap.get(deviceId, PT_NRPN, quantParam)
  if q == nil then q = parameterMap.get(deviceId, PT_VIRTUAL, quantParam) end
  return tonumber(q)
end

-- Quantize given signed display value (signedInput in -8192..+8191) for given quantParam.
-- Returns quantized raw14 value (0..16383), integer n (step multiplier), and mode table.
local function quantizeSignedFor(signedInput, quantParam)
  local signed = clamp(tonumber(signedInput) or 0, SIGN_MIN, SIGN_MAX)
  local qmode = readQuantModeFor(quantParam)
  local mode = QUANT_MODES[qmode] or QUANT_MODES[2]

  local minSigned = (mode.minSemitones ~= nil) and (mode.minSemitones * STEP_SEMITONE) or SIGN_MIN
  local maxSigned = (mode.maxSemitones ~= nil) and (mode.maxSemitones * STEP_SEMITONE) or SIGN_MAX
  signed = clamp(signed, minSigned, maxSigned)

  -- free modes
  if not mode.quant then
    if not mode.symmetric and signed < 0 then signed = 0 end
    local qRaw = clamp(signed + CENTER_RAW, RAW_MIN, RAW_MAX)
    return qRaw, 0, mode
  end

  -- octave-display modes: quantize in octave units directly
  if mode.octaveDisplay then
    local oct = signed / STEP_OCTAVE
    local octN = (oct >= 0) and math.floor(oct + 0.5) or math.ceil(oct - 0.5)

    local minOct = math.ceil(minSigned / STEP_OCTAVE)
    local maxOct = math.floor(maxSigned / STEP_OCTAVE)
    if octN < minOct then octN = minOct end
    if octN > maxOct then octN = maxOct end

    local qSigned = octN * STEP_OCTAVE
    local qRaw = clamp(qSigned + CENTER_RAW, RAW_MIN, RAW_MAX)

    -- keep n in semitone-step units for downstream formatter math
    local n = math.floor(qSigned / STEP_SEMITONE + (qSigned >= 0 and 0.5 or -0.5))
    return qRaw, n, mode
  end

  -- semitone quantized modes
  local step = mode.step or STEP_SEMITONE
  local n = roundNearestSteps(signed, step)

  local minN = math.ceil(minSigned / step)
  local maxN = math.floor(maxSigned / step)
  if n < minN then n = minN end
  if n > maxN then n = maxN end

  local qSigned = n * step
  local qRaw = clamp(qSigned + CENTER_RAW, RAW_MIN, RAW_MAX)
  return qRaw, n, mode
end

-- Helper to apply quant result to UI
local function applyQuantResult(qRaw, n, mode, ctrlId, valueObject, quantParam)
  local signedOutput = qRaw - CENTER_RAW
  local ctrl = valueObject
  if not ctrl then ctrl = safeGet(ctrlId) end
  if ctrl and type(ctrl.setValue) == "function" then
    pcall(function() ctrl:setValue(signedOutput) end)
  end
end

-- robust incoming value normalization: accepts signed (-8192..8191) or unsigned (0..16383)
local function normalizeIncomingToSigned(incoming)
  incoming = tonumber(incoming) or 0
  if incoming >= 0 and incoming <= RAW_MAX then
    if incoming > SIGN_MAX then
      return incoming - CENTER_RAW -- unsigned -> signed
    else
      return incoming -- already signed
    end
  end
  return clamp(incoming, SIGN_MIN, SIGN_MAX)
end

-- Osc 1: NRPN param 513, quant param 535, control id 328 -> function name quantizeOscillator1Frequency
function quantizeOscillator1Frequency(valueObject, value)
  local rawInput = (value ~= nil) and value or (valueObject and (type(valueObject.getValue) == "function" and valueObject:getValue() or valueObject) or 0)
  local incoming = normalizeIncomingToSigned(rawInput)
  local qRaw, n, mode = quantizeSignedFor(incoming, 535)
  parameterMap.set(deviceId, PT_NRPN, 513, qRaw)
  applyQuantResult(qRaw, n, mode, 328, valueObject, 535)
end

-- Osc 2: NRPN param 515, quant param 536, control id 95 -> function name quantizeOscillator2Frequency
function quantizeOscillator2Frequency(valueObject, value)
  local rawInput = (value ~= nil) and value or (valueObject and (type(valueObject.getValue) == "function" and valueObject:getValue() or valueObject) or 0)
  local incoming = normalizeIncomingToSigned(rawInput)
  local qRaw, n, mode = quantizeSignedFor(incoming, 536)
  parameterMap.set(deviceId, PT_NRPN, 515, qRaw)
  applyQuantResult(qRaw, n, mode, 95, valueObject, 536)
end

-- helper function for making osc1 and osc2 frequency format
local function formatFreqCommon(value, quantParam)
  local signed = normalizeIncomingToSigned(value)
  local _, n, mode = quantizeSignedFor(signed, quantParam)
  if mode and mode.quant then
    local semitoneValue = (n * (mode.step or STEP_SEMITONE)) / STEP_SEMITONE
    local showOct = mode.octaveDisplay or (semitoneValue % 12 == 0)
    if showOct then
      local oct = semitoneValue / 12
      local octaveInteger = (oct >= 0) and math.floor(oct + 0.5) or math.ceil(oct - 0.5)
      return string.format("%+d oct", octaveInteger)
    end

    local semitoneInteger = (semitoneValue >= 0) and math.floor(semitoneValue + 0.5) or math.ceil(semitoneValue - 0.5)
    return string.format("%+d st", semitoneInteger)
  end
  return tostring(signed)
end

function formatOscillator1Frequency(valueObject, value)
  return formatFreqCommon(value, 535)
end

function formatOscillator2Frequency(valueObject, value)
  return formatFreqCommon(value, 536)
end

