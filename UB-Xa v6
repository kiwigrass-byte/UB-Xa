-- Construct a midi.onNrpn(callback) by listening to midi.onControlChange
-- callback(channel, nrpnParam, value, info)
-- nrpnParam = 0..16383 (msb*128 + lsb)
-- value = combined 14-bit value if LSB available, otherwise 7-bit MSB value (or amount for inc/dec)
-- info.type = "data_entry_msb" | "data_entry_lsb" | "inc" | "dec"
-- info.msb / info.lsb included when applicable
-- core processor expects (channel, controller, value)
function processControlChange(channel, controller, value)
  if not channel then return end
  local channelState = nrpnState[channel] or { nrpnMsb = nil, nrpnLsb = nil, dataMsb = nil, dataLsb = nil }
  -- NRPN parameter select
  if controller == 99 then -- NRPN MSB
    if value == 127 then
      -- deselect NRPN
      channelState.nrpnMsb = nil; channelState.nrpnLsb = nil; channelState.dataMsb = nil; channelState.dataLsb = nil
    else
      channelState.nrpnMsb = value
      channelState.dataMsb = nil; channelState.dataLsb = nil
    end
  elseif controller == 98 then -- NRPN LSB
    if value == 127 then
      channelState.nrpnMsb = nil; channelState.nrpnLsb = nil; channelState.dataMsb = nil; channelState.dataLsb = nil
    else
      channelState.nrpnLsb = value
      channelState.dataMsb = nil; channelState.dataLsb = nil
    end
  -- Data Entry MSB (CC 6)
  elseif controller == 6 then
    if channelState.nrpnMsb and channelState.nrpnLsb then
      channelState.dataMsb = value
      local param = channelState.nrpnMsb * 128 + channelState.nrpnLsb
      local combined = value
      if channelState.dataLsb then
        combined = (channelState.dataMsb * 128) + channelState.dataLsb
      end
      if nrpnCallback then
        nrpnCallback(channel, param, combined, { type = "data_entry_msb", msb = value, lsb = channelState.dataLsb })
      end
    end
  -- Data Entry LSB (CC 38)
  elseif controller == 38 then
    if channelState.nrpnMsb and channelState.nrpnLsb then
      channelState.dataLsb = value
      local param = channelState.nrpnMsb * 128 + channelState.nrpnLsb
      local combined = ((channelState.dataMsb or 0) * 128) + channelState.dataLsb
      if nrpnCallback then
        nrpnCallback(channel, param, combined, { type = "data_entry_lsb", msb = channelState.dataMsb, lsb = value })
      end
    end
  -- Data Increment (96) / Decrement (97)
  elseif controller == 96 or controller == 97 then
    if channelState.nrpnMsb and channelState.nrpnLsb then
      local param = channelState.nrpnMsb * 128 + channelState.nrpnLsb
      local kind = controller == 96 and "inc" or "dec"
      if nrpnCallback then
        nrpnCallback(channel, param, value, { type = kind, amount = value })
      end
    end
  end
  nrpnState[channel] = channelState
end

-- wrapper that normalizes incoming args:
-- supports (channel, controller, value) and (port, channel, controller, value)
local function controlChangeWrapper(...)
  local n = select("#", ...)
  if n == 4 then
    -- (port, channel, controller, value)
    local _, channel, controller, value = ...
    processControlChange(channel, controller, value)
  else
    -- assume (channel, controller, value)
    local channel, controller, value = ...
    processControlChange(channel, controller, value)
  end
end

-- Utility: try to call a possible registrar safely
local function tryCallRegistrar(registrar, handler)
  local ok, err = pcall(function() registrar(handler) end)
  return ok, err
end

-- Register a single NRPN callback. Calling multiple times replaces the previous callback.
function midi.onNrpn(callback)
  nrpnCallback = callback
  if not registered then
    -- If midi.onControlChange is a function, it might be either:
    -- 1) a registrar function that accepts a handler, or
    -- 2) an existing handler (callable) that should be wrapped/kept.
    local controlChangeHandler = midi.onControlChange
    if type(controlChangeHandler) == "function" then
      -- First attempt: try calling it as a registrar: midi.onControlChange(handler)
      local ok = tryCallRegistrar(controlChangeHandler, controlChangeWrapper)
      if ok then
        -- registration succeeded (API is registrar-style)
        registered = true
        return
      else
        -- calling it failed -> treat it as an existing handler: wrap it
        local existing = controlChangeHandler
        midi.onControlChange = function(...)
          -- preserve existing behavior
          pcall(existing, ...)
          -- then run our wrapper
          controlChangeWrapper(...)
        end
        registered = true
        return
      end
    else
      -- Not a function (nil or not present) -> assign directly
      midi.onControlChange = controlChangeWrapper
      registered = true
      return
    end
  end
end

