-- bitmask helper function ---
function sendBitmask(paramNumber, deviceId, parameterList)
  local value = 0
  for i,p in ipairs(parameterList) do
    if p and parameterMap.get(deviceId, PT_VIRTUAL, p) ~= 0 then
      value = value + (1 << (i-1))
    end
  end
  local parameterMSB = (paramNumber >> 7) & 0x7F
  local parameterLSB = paramNumber & 0x7F
  local valueMSB = (value >> 7) & 0x7F
  local valueLSB = value & 0x7F
--print("parameterMSB "..parameterMSB.." parameterLSB " ..parameterLSB.. " valueMSB "..valueMSB.." valueLSB ".. valueLSB)
  midi.sendControlChange(currentPort, currentChannel, 99, parameterMSB)
  midi.sendControlChange(currentPort, currentChannel, 98, parameterLSB)
  midi.sendControlChange(currentPort, currentChannel, 6, valueMSB)
  midi.sendControlChange(currentPort, currentChannel, 38, valueLSB)
end

