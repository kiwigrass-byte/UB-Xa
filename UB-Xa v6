function displaySD(valueObject, value)
  local BANK_NAMES = {"A","B","C","D"}
  local CTRL_UPPER_NAME_SINGLE = 166
  local CTRL_LOWER_NAME_SINGLE = 174
  local CTRL_UPPER_NAME_DOUBLE = 216
  local CTRL_LOWER_NAME_DOUBLE = 226
  local mode = parameterMap.get(deviceId, PT_VIRTUAL, 10028)
  -- reset sticky params on specific mode transitions (both directions)
  if lastDisplaySDMode ~= nil and mode ~= nil and lastDisplaySDMode ~= mode then
    -- between 0 and 1: always clear 10030/10024
    if (lastDisplaySDMode == 0 and mode == 1) or (lastDisplaySDMode == 1 and mode == 0) then
      parameterMap.set(deviceId, PT_VIRTUAL, 10030, 0)
      parameterMap.set(deviceId, PT_VIRTUAL, 10024, 0)
    end
    -- between 1 and 2: always clear 10023/10024
    if (lastDisplaySDMode == 1 and mode == 2) or (lastDisplaySDMode == 2 and mode == 1) then
      parameterMap.set(deviceId, PT_VIRTUAL, 10023, 0)
      parameterMap.set(deviceId, PT_VIRTUAL, 10024, 0)
    end
  end
  lastDisplaySDMode = mode

  if not mode or mode == 0 then return end   -- nothing to show in single mode
  local baseIndex
  if mode == 2 then
    baseIndex = value + 1
  elseif mode == 1 then
    baseIndex = value + 37
  else
    return
  end

  -- validate splitDoubleMatrix row exists
  local row = splitDoubleMatrix[baseIndex]
  if not row then return end
  -- read row fields once; +1 conversions and floor just in case values are floats
  local upperProgramNumber = math.floor((row[1] or 0) + 1)
  local upperBankNumber = math.floor((row[2] or 0) + 1)
  local lowerProgramNumber = math.floor((row[3] or 0) + 1)
  local lowerBankNumber = math.floor((row[4] or 0) + 1)
  -- pick controls based on which half we're updating
  local isFirstHalf = baseIndex >= 1 and baseIndex < 37
  local ctrlUpper = isFirstHalf and CTRL_UPPER_NAME_SINGLE or CTRL_UPPER_NAME_DOUBLE
  local ctrlLower = isFirstHalf and CTRL_LOWER_NAME_SINGLE or CTRL_LOWER_NAME_DOUBLE
  -- set upper patch name if available
  if patchNameBank and patchNameBank[upperBankNumber] and patchNameBank[upperBankNumber][upperProgramNumber] then
    local displayName = BANK_NAMES[upperBankNumber] .. tostring(upperProgramNumber) .. " " .. (patchNameBank[upperBankNumber][upperProgramNumber] or "")
    controls.get(ctrlUpper):setName(displayName)
  end
  -- set lower patch name if available
  if patchNameBank and patchNameBank[lowerBankNumber] and patchNameBank[lowerBankNumber][lowerProgramNumber] then
    controls.get(ctrlLower):setName(BANK_NAMES[lowerBankNumber]..lowerProgramNumber.." "..patchNameBank[lowerBankNumber][lowerProgramNumber])
  end
  -- parameter mappings (unified table: {targetParam, srcIndex, multiplier})
  local parameterMappings = {
    {130, 8, 64},   -- Performance pitch bend range (/64)
    {131, 9, 64},   -- Performance octave pitch transpose (/64)
    {134, 10, 64},  -- Performance LFO depth (/64)
    {132, 11, 64},  -- Performance LFO rate (/64)
    {1280, 6, 1},   -- Performance keyboard split point
    {133, 12, 1},   -- Performance LFO shape
  }
  for _, mapping in ipairs(parameterMappings) do
    local sourceValue = row[mapping[2]] or 0
    parameterMap.set(deviceId, PT_NRPN, mapping[1], sourceValue * mapping[3])
  end
  -- pset mappings (keeps original grouping)
  local presetMappings = {
    {{115,117,118,119}, row[5]},           -- Performance LFO mods
    {{8,10,19,97,103,109}, row[7]},        -- Performance panel settings
  }
  for _, mapping in ipairs(presetMappings) do
    pset(mapping[1], mapping[2])
  end
end

-- panning control parameter
function setPanType(valueObject, type)
  if type == nil then return end
  local panWidthControl = math.min(parameterMap.get(deviceId, PT_VIRTUAL,201),100)
  local parameterList = {
    2176,2177,2178,2179,2180,2181,2182,2183,
    2184,2185,2186,2187,2188,2189,2190,2191
  }
  local value = 0
  local steps = {0, 85, 170, 255}
  for i, param in ipairs(parameterList) do  
    if     type == 0 then value = 128 --  center all (128);
    elseif type == 1 then value = (i % 2 == 1) and 0 or 255 -- alternate left/right: odd indices -> 0, even indices -> 255   
    elseif type == 2 then value = steps[((i - 1) % 4) + 1] -- four-step pan groups: 0, 64, 192, 255 repeating every 4 voices
    else value = math.random(0, 255) -- random 
    end    
    parameterMap.set(deviceId, PT_NRPN, param, math.floor(128+(value-128)*panWidthControl/100))
    panDefaultValues[i]=value
  end  
end 

