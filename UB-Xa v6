local function safeGet(id)
  local ok, control = pcall(controls.get, id)
  return ok and control or nil
end

-- Normalize incoming channel to Electra's expected range.
-- Set CHANNEL_BASE to 0 since UB-Xa channel value is 0..15.
local CHANNEL_BASE = 0

local function normalizeChannel(channel)
  channel = tonumber(channel)
  if not channel then return nil end
  if CHANNEL_BASE == 1 then
    channel = channel - 1
  end
  if channel < 0 then channel = 0 end
  if channel > 15 then channel = 15 end
  return channel
end

local function refreshCurrentDeviceSnapshot()
  currentChannel = currentDevice:getChannel()
  deviceId = currentDevice:getId()
  currentPort = currentDevice:getPort()
end

local function applySynthChannels()
  if synthUpperChannel ~= nil then upperDevice:setChannel(synthUpperChannel) end
  if synthLowerChannel ~= nil then lowerDevice:setChannel(synthLowerChannel) end
  -- keep currentDevice in sync with selected part
  -- value mapping in your code: 0 = upper, 1 = lower
  local partSel = parameterMap.get(deviceId, PT_VIRTUAL, 10029)
  if partSel == 0 and synthUpperChannel ~= nil then
    currentDevice:setChannel(synthUpperChannel)
  elseif partSel == 1 and synthLowerChannel ~= nil then
    currentDevice:setChannel(synthLowerChannel)
  end
  refreshCurrentDeviceSnapshot()
end

function assignChannel(valueObject, value)
  -- Prefer UB-Xa-reported channels when both are known
  if channelsFromSynth and synthUpperChannel ~= nil and synthLowerChannel ~= nil then
    if value == 0 then -- upper
      currentDevice:setChannel(synthUpperChannel)
    elseif value == 1 then -- lower
      currentDevice:setChannel(synthLowerChannel)
    end
  else
    -- Fallback to Electra editor UI settings
    if value == 0 then -- upper
      currentDevice:setChannel(upperDevice:getChannel())
    elseif value == 1 then -- lower
      currentDevice:setChannel(lowerDevice:getChannel())
    end
  end
  refreshCurrentDeviceSnapshot()
--  print("current channel now: "..tostring(currentChannel))
end

-- helper function to make a matrix. fill is optional
local function initMatrix(rows, cols, fill)
  if rows <= 0 or cols <= 0 then return {} end
  if fill == nil then fill = 0 end
  local matrix = {}
  for rowIndex = 1, rows do
    local row = {}
    for columnIndex = 1, cols do
      if type(fill) == "function" then
        row[columnIndex] = fill(rowIndex, columnIndex)
      else
        row[columnIndex] = fill
      end
    end
    matrix[rowIndex] = row
  end
  return matrix
end

